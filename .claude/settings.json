{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm build)",
      "Bash(pnpm run build)",
      "Bash(pnpm clean)",
      "Bash(pnpm run clean)",
      "Bash(pnpm format)",
      "Bash(pnpm run format)",
      "Bash(pnpm format:check)",
      "Bash(pnpm run format:check)",
      "Bash(pnpm lint)",
      "Bash(pnpm run lint)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm run typecheck)",
      "Bash(pnpm test)",
      "Bash(pnpm run test)",
      "Bash(pnpm test:coverage)",
      "Bash(pnpm run test:coverage)",
      "Bash(pnpm api:check)",
      "Bash(pnpm run api:check)",
      "Bash(pnpm api:update)",
      "Bash(pnpm run api:update)",
      "Bash(pnpm package:lint)",
      "Bash(pnpm run package:lint)",
      "Bash(pnpm package:smoke)",
      "Bash(pnpm run package:smoke)",
      "Bash(pnpm docs:build)",
      "Bash(pnpm run docs:build)",
      "Bash(pnpm check:quick)",
      "Bash(pnpm run check:quick)",
      "Bash(pnpm check)",
      "Bash(pnpm run check)",
      "Bash(pnpm fix)",
      "Bash(pnpm run fix)",
      "Bash(pnpm exec eslint:*)",
      "Bash(pnpm exec prettier:*)",
      "Bash(pnpm exec tsc:*)",
      "Bash(pnpm exec vitest run:*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(secrets/**)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(secrets/**)",
      "Edit(pnpm-lock.yaml)",
      "Edit(package-lock.json)",
      "Edit(npm-shrinkwrap.json)",
      "Edit(yarn.lock)",
      "Edit(bun.lockb)",
      "Bash(npm publish)",
      "Bash(npm publish *)",
      "Bash(pnpm publish)",
      "Bash(pnpm publish *)",
      "Bash(yarn publish)",
      "Bash(yarn publish *)",
      "Bash(bun publish)",
      "Bash(bun publish *)",
      "Bash(gh workflow run)",
      "Bash(gh workflow run *)",
      "Bash(gh release create)",
      "Bash(gh release create *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|Read|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.mjs\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/format.mjs\"",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/stop-check.mjs\"",
            "timeout": 180
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "tomada-claude-plugins": {
      "source": {
        "source": "github",
        "repo": "tomada1114/tomada-claude-plugins"
      }
    }
  },
  "enabledPlugins": {
    "tomada-kit@tomada-claude-plugins": true
  }
}
