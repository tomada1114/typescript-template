{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "isolatedDeclarations": true,

    // The published artifact is TypeScript output only; repository automation
    // never ships.
    "allowJs": false,
    "checkJs": false,

    // Node profiles may use `node:` builtins in src. The universal profile
    // replaces this with `"types": []` so a Node-only import fails the build
    // instead of silently narrowing where the package can run.
    "types": ["node"]
  },
  "include": ["src"],
  "exclude": ["tests", "scripts", "**/*.test.ts"]
}
